{
	"id": "about_gallery",
	"type": "SharedSlice",
	"name": "AboutGallery",
	"description": "About — Gallery: carousel of images/videos.",
	"variations": [
		{
			"id": "default",
			"name": "Default",
			"docURL": "...",
			"version": "initial",
			"description": "Default",
			"imageUrl": "",
			"primary": {
				"title": {
					"type": "Text",
					"config": {
						"label": "Title",
						"placeholder": ""
					}
				},
				"title_color": {
					"type": "Select",
					"config": {
						"label": "Title Color",
						"placeholder": "",
						"options": ["white", "black"],
						"default_value": "white"
					}
				},
				"items": {
					"type": "Group",
					"config": {
						"label": "Items",
						"repeat": true,
						"fields": {
							"title": {
								"type": "Text",
								"config": {
									"label": "Title (overrides slice title)",
									"placeholder": ""
								}
							},
							"title_color": {
								"type": "Select",
								"config": {
									"label": "Title Color (overrides slice)",
									"placeholder": "",
									"options": ["white", "black"]
								}
							},
							"image": {
								"type": "Image",
								"config": {
									"label": "Image",
									"constraint": {},
									"thumbnails": []
								}
							},
							"video_url": {
								"type": "Text",
								"config": {
									"label": "Video Url",
									"placeholder": ""
								}
							},
							"play": {
								"type": "Select",
								"config": {
									"label": "Play",
									"placeholder": "",
									"options": ["no-sound", "has-sound", "click-to-play-with-sound"],
									"default_value": "no-sound"
								}
							}
						}
					}
				},
				"video_playback_mode": {
					"type": "Select",
					"config": {
						"label": "Video Playback Mode",
						"placeholder": "",
						"options": ["continuous", "restart"],
						"default_value": "continuous"
					}
				},
				"preferred_format": {
					"type": "Select",
					"config": {
						"label": "Preferred Format",
						"placeholder": "",
						"options": ["square", "landscape", "portrait"],
						"default_value": "square"
					}
				},
				"force_format": {
					"type": "Boolean",
					"config": {
						"label": "Force Format (don't crop)",
						"placeholder_false": "false",
						"placeholder_true": "true",
						"default_value": false
					}
				},
				"hide_on_mobile": {
					"type": "Boolean",
					"config": {
						"label": "Hide on Mobile",
						"placeholder_false": "false",
						"placeholder_true": "true",
						"default_value": false
					}
				}
			},
			"items": {}
		}
	]
}
